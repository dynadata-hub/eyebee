# Production Environment Variables for eyebee
# Copy this file to .env.production and adjust values as needed

# Main domain configuration
# All services (web, api, speedtest) will use the same domain
DOMAIN=live.eyebee.com

# Server IPs
SERVER_IPV4=164.92.212.133
SERVER_IPV6=2a03:b0c0:2:f0:0:1:49e8:7001

# Let's Encrypt configuration
LETSENCRYPT_EMAIL=admin@eyebee.com

# Firebase configuration
FIREBASE_PROJECT_ID=eyebee-718a0
FIREBASE_STORAGE_BUCKET=eyebee-718a0.appspot.com

# Node environment
NODE_ENV=production
