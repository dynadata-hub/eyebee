# Eyebee Web App — Environment Variables
# Copy to .env and adjust values for your environment.
# Variables prefixed with REACT_APP_ are injected at build time.

# Socket.io / API endpoint (default: "/" for production with nginx proxy)
# For local development: http://localhost:5000 or http://192.168.x.x
REACT_APP_SOCKET_ENDPOINT=/

# Base URL for room links generated in admin panel
# (default: auto-detected from window.location.origin)
# REACT_APP_BASE_URL=https://live.eyebee.com

# TURN server (for WebRTC NAT traversal)
# REACT_APP_TURN_URL=turn:livelatency.com
# REACT_APP_TURN_USERNAME=immersiveclass
# REACT_APP_TURN_CREDENTIAL=1mm3r51v3c1455

# Speed test endpoints (relative paths work with nginx proxy)
# REACT_APP_SPEEDTEST_DOWNLOAD=/speedtest/download/500mb.bin
# REACT_APP_SPEEDTEST_UPLOAD=/speedtest/upload
# REACT_APP_SPEEDTEST_PING=/speedtest/ping
